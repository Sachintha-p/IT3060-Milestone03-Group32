# =====================================================================
# Smart Library System — Frontend Environment Variables
# =====================================================================
# Copy this file to .env (git-ignored) and fill in the values.
# Never commit real secrets or .env files.

# Backend API base URL.
# Android emulator → localhost on your machine maps to 10.0.2.2
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Use your laptop's Wi-Fi IP for testing on a real Android/iOS device:
# EXPO_PUBLIC_API_URL=http://192.168.1.X:8080
